{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "money-tracker",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "money",
      "database_id": "f7295dbf-367e-438b-82fc-27e95263aa2b",
      "migrations_dir": "migrations"
    }
  ]
  // Phase 4 adds: "assets": { "directory": "../web/dist", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] }
}
