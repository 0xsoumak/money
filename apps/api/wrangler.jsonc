{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "money-tracker",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // The built web app (apps/web/dist). Only /api/* runs the Worker; everything else is static and free.
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "BETTER_AUTH_URL": "https://money-tracker.soumakkdutta.workers.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "money",
      "database_id": "f7295dbf-367e-438b-82fc-27e95263aa2b",
      "migrations_dir": "migrations"
    }
  ]
}
