{
  "name": "@money/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply money --local",
    "db:migrate:remote": "wrangler d1 migrations apply money --remote",
    "create-user": "tsx scripts/create-user.ts",
    "build:types": "tsc -p tsconfig.types.json"
  },
  "dependencies": {
    "@hono/zod-validator": "0.9.1",
    "@money/shared": "workspace:*",
    "better-auth": "1.7.19",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.17",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.6.1",
    "@types/node": "^24.19.2",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "vitest": "5.1.0",
    "wrangler": "4.159.0"
  },
  "exports": {
    ".": {
      "types": "./dist-types/index.d.ts"
    }
  }
}
